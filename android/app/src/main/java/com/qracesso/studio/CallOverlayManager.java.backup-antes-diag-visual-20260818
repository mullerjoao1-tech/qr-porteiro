package com.qracesso.studio;

import android.content.Context;
import android.content.Intent;
import android.graphics.Color;
import android.graphics.PixelFormat;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import android.util.Log;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.TextView;

public class CallOverlayManager {
    private static final String TAG = "CallOverlayManager";
    private static final Handler mainHandler = new Handler(Looper.getMainLooper());
    private static View activeOverlayView = null;
    private static WindowManager activeWindowManager = null;

    private static int dpToPx(Context context, int dp) {
        return (int) TypedValue.applyDimension(
                TypedValue.COMPLEX_UNIT_DIP,
                dp,
                context.getResources().getDisplayMetrics()
        );
    }

    public static synchronized void show(
            final Context context,
            final String unidadeId,
            final String nomeVisitante,
            final String motivoChamada,
            final String route
    ) {
        if (Looper.myLooper() != Looper.getMainLooper()) {
            mainHandler.post(() -> show(context, unidadeId, nomeVisitante, motivoChamada, route));
            return;
        }

        dismiss();

        try {
            final WindowManager windowManager =
                    (WindowManager) context.getSystemService(Context.WINDOW_SERVICE);
            if (windowManager == null) {
                Log.e(TAG, "WindowManager indisponÃ­vel");
                return;
            }

            int layoutType = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
                    ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
                    : WindowManager.LayoutParams.TYPE_PHONE;

            WindowManager.LayoutParams windowParams = new WindowManager.LayoutParams(
                    WindowManager.LayoutParams.MATCH_PARENT,
                    WindowManager.LayoutParams.MATCH_PARENT,
                    layoutType,
                    WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL |
                    WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON |
                    WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                    PixelFormat.TRANSLUCENT
            );
            windowParams.gravity = Gravity.CENTER;

            // Layout Raiz (Fundo escuro translÃºcido em tela cheia)
            FrameLayout rootLayout = new FrameLayout(context);
            rootLayout.setBackgroundColor(Color.argb(235, 10, 15, 30));

            // Card Central
            LinearLayout card = new LinearLayout(context);
            card.setOrientation(LinearLayout.VERTICAL);
            card.setGravity(Gravity.CENTER_HORIZONTAL);

            GradientDrawable cardBg = new GradientDrawable();
            cardBg.setColor(Color.parseColor("#1E293B"));
            cardBg.setCornerRadius(dpToPx(context, 20));
            cardBg.setStroke(dpToPx(context, 1), Color.parseColor("#334155"));
            card.setBackground(cardBg);

            int cardPadding = dpToPx(context, 28);
            card.setPadding(cardPadding, cardPadding, cardPadding, cardPadding);

            FrameLayout.LayoutParams cardParams = new FrameLayout.LayoutParams(
                    FrameLayout.LayoutParams.MATCH_PARENT,
                    FrameLayout.LayoutParams.WRAP_CONTENT
            );
            cardParams.gravity = Gravity.CENTER;
            cardParams.leftMargin = dpToPx(context, 24);
            cardParams.rightMargin = dpToPx(context, 24);
            card.setLayoutParams(cardParams);

            // 1. Badge "CHAMADA RECEBIDA"
            TextView badge = new TextView(context);
            badge.setText("CHAMADA RECEBIDA");
            badge.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
            badge.setTextColor(Color.parseColor("#38BDF8"));
            badge.setTypeface(Typeface.DEFAULT_BOLD);
            badge.setGravity(Gravity.CENTER);

            GradientDrawable badgeBg = new GradientDrawable();
            badgeBg.setColor(Color.parseColor("#0C4A6E"));
            badgeBg.setCornerRadius(dpToPx(context, 12));
            badge.setBackground(badgeBg);
            badge.setPadding(
                    dpToPx(context, 14),
                    dpToPx(context, 6),
                    dpToPx(context, 14),
                    dpToPx(context, 6)
            );
            card.addView(badge);

            // 2. Nome do Visitante
            TextView txtNome = new TextView(context);
            String nome = (nomeVisitante != null && !nomeVisitante.trim().isEmpty())
                    ? nomeVisitante.trim()
                    : "Visitante";
            txtNome.setText(nome);
            txtNome.setTextSize(TypedValue.COMPLEX_UNIT_SP, 24);
            txtNome.setTextColor(Color.WHITE);
            txtNome.setTypeface(Typeface.DEFAULT_BOLD);
            txtNome.setGravity(Gravity.CENTER);

            LinearLayout.LayoutParams paramsNome = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT
            );
            paramsNome.topMargin = dpToPx(context, 18);
            txtNome.setLayoutParams(paramsNome);
            card.addView(txtNome);

            // 3. DescriÃ§Ã£o / Unidade
            TextView txtDesc = new TextView(context);
            String desc = (motivoChamada != null && !motivoChamada.trim().isEmpty())
                    ? (motivoChamada.trim() + " • Unidade " + unidadeId)
                    : ("Unidade " + unidadeId);
            txtDesc.setText(desc);
            txtDesc.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
            txtDesc.setTextColor(Color.parseColor("#94A3B8"));
            txtDesc.setGravity(Gravity.CENTER);

            LinearLayout.LayoutParams paramsDesc = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT
            );
            paramsDesc.topMargin = dpToPx(context, 8);
            paramsDesc.bottomMargin = dpToPx(context, 28);
            txtDesc.setLayoutParams(paramsDesc);
            card.addView(txtDesc);

            // 4. Container de BotÃµes
            LinearLayout buttonLayout = new LinearLayout(context);
            buttonLayout.setOrientation(LinearLayout.HORIZONTAL);
            buttonLayout.setLayoutParams(new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.MATCH_PARENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT
            ));

            // BotÃ£o RECUSAR
            Button btnRecusar = new Button(context);
            btnRecusar.setText("RECUSAR");
            btnRecusar.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
            btnRecusar.setTextColor(Color.WHITE);
            btnRecusar.setTypeface(Typeface.DEFAULT_BOLD);

            GradientDrawable btnRecusarBg = new GradientDrawable();
            btnRecusarBg.setColor(Color.parseColor("#DC2626"));
            btnRecusarBg.setCornerRadius(dpToPx(context, 12));
            btnRecusar.setBackground(btnRecusarBg);

            LinearLayout.LayoutParams paramsRecusar = new LinearLayout.LayoutParams(
                    0,
                    dpToPx(context, 54),
                    1.0f
            );
            paramsRecusar.rightMargin = dpToPx(context, 6);
            btnRecusar.setLayoutParams(paramsRecusar);

            btnRecusar.setOnClickListener(v -> {
                dismiss();
                Intent declineIntent = new Intent(context, MainActivity.class);
                declineIntent.addFlags(
                        Intent.FLAG_ACTIVITY_NEW_TASK |
                        Intent.FLAG_ACTIVITY_SINGLE_TOP |
                        Intent.FLAG_ACTIVITY_CLEAR_TOP
                );
                declineIntent.putExtra("route", route);
                declineIntent.putExtra("pararToqueChamada", true);
                declineIntent.putExtra("acaoChamada", "nao-posso-atender");
                try {
                    context.startActivity(declineIntent);
                } catch (Exception e) {
                    Log.e(TAG, "Erro ao enviar recusa de chamada pelo overlay", e);
                }
            });
            buttonLayout.addView(btnRecusar);

            // BotÃ£o ATENDER
            Button btnAtender = new Button(context);
            btnAtender.setText("ATENDER");
            btnAtender.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
            btnAtender.setTextColor(Color.WHITE);
            btnAtender.setTypeface(Typeface.DEFAULT_BOLD);

            GradientDrawable btnAtenderBg = new GradientDrawable();
            btnAtenderBg.setColor(Color.parseColor("#16A34A"));
            btnAtenderBg.setCornerRadius(dpToPx(context, 12));
            btnAtender.setBackground(btnAtenderBg);

            LinearLayout.LayoutParams paramsAtender = new LinearLayout.LayoutParams(
                    0,
                    dpToPx(context, 54),
                    1.0f
            );
            paramsAtender.leftMargin = dpToPx(context, 6);
            btnAtender.setLayoutParams(paramsAtender);

            btnAtender.setOnClickListener(v -> {
                dismiss();
                Intent answerIntent = new Intent(context, MainActivity.class);
                answerIntent.addFlags(
                        Intent.FLAG_ACTIVITY_NEW_TASK |
                        Intent.FLAG_ACTIVITY_SINGLE_TOP |
                        Intent.FLAG_ACTIVITY_CLEAR_TOP
                );
                answerIntent.putExtra("route", route);
                answerIntent.putExtra("pararToqueChamada", true);
                try {
                    context.startActivity(answerIntent);
                } catch (Exception e) {
                    Log.e(TAG, "Erro ao abrir MainActivity ao atender pelo overlay", e);
                }
            });
            buttonLayout.addView(btnAtender);

            card.addView(buttonLayout);
            rootLayout.addView(card);

            windowManager.addView(rootLayout, windowParams);
            activeOverlayView = rootLayout;
            activeWindowManager = windowManager;
            Log.d(TAG, "Call overlay exibido com sucesso");

        } catch (Exception e) {
            Log.e(TAG, "Erro ao exibir call overlay", e);
            dismiss();
        }
    }

    public static synchronized void dismiss() {
        if (Looper.myLooper() != Looper.getMainLooper()) {
            mainHandler.post(CallOverlayManager::dismiss);
            return;
        }

        if (activeOverlayView != null && activeWindowManager != null) {
            try {
                activeWindowManager.removeView(activeOverlayView);
                Log.d(TAG, "Call overlay removido");
            } catch (Exception e) {
                Log.w(TAG, "Erro ao remover call overlay", e);
            }
            activeOverlayView = null;
            activeWindowManager = null;
        }
    }
}


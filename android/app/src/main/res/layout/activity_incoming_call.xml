<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Container para vídeo futuro (WebRTC SurfaceView) -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Card Principal (Estilo Morador V2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="400dp"
                android:orientation="vertical"
                android:background="@drawable/bg_call_card"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Ícone Emoji -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨"
                    android:textSize="50sp"
                    android:layout_marginBottom="12dp" />

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHAMADA RECEBIDA"
                    android:textColor="#4ADE80"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <!-- Box de Informações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_box"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/txt_nome_visitante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Visitante"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/txt_motivo_unidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Motivo: Não informado"
                        android:textColor="#CBD5E1"
                        android:textSize="16sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: Aguardando atendimento"
                        android:textColor="#FACC15"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Box da Câmera (Placeholder) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_box"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷 Câmera do portão"
                        android:textColor="#4ADE80"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="#0F172A"
                        android:layout_margin="4dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capturando imagem..."
                            android:textColor="#94A3B8"
                            android:textSize="14sp"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Botão Atender -->
                <Button
                    android:id="@+id/btn_atender"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:text="✅ ATENDER AGORA"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:backgroundTint="#22C55E"
                    />

                <!-- Botão Não Posso Atender -->
                <Button
                    android:id="@+id/btn_nao_posso_atender"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:text="🔵 NÃO POSSO ATENDER"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2563EB"
                    />

                <!-- Aviso Inferior -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_warning_box"
                    android:padding="12dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ouça o áudio e veja a câmera. Para responder, clique em ATENDER AGORA."
                        android:textColor="#FDE047"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>

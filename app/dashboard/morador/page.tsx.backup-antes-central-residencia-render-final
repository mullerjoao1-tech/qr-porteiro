"use client";

import {
  useMemo,
  useState,
} from "react";

import {
  useRouter,
} from "next/navigation";

import DashboardBase from "@/app/components/core/dashboard/DashboardBase";
import CentralResidencia from "@/app/dashboard/condominio/CentralResidencia";
import { useAuth } from "@/app/context/AuthContext";

function normalizarTexto(
  valor?: string | null
) {
  return (valor || "")
    .trim()
    .toLowerCase()
    .replaceAll("_", " ")
    .replaceAll("-", " ");
}

export default function PaginaMorador() {
  const router =
    useRouter();

  const {
    usuario,
    carregando,
    vinculoSelecionadoId,
    vinculoSelecionado,
    logout,
  } = useAuth();

  const [
    saindo,
    setSaindo,
  ] =
    useState(false);

  const [
    abrindoPortao,
    setAbrindoPortao,
  ] =
    useState(false);

  const [
    statusPortao,
    setStatusPortao,
  ] =
    useState("");

  const nomeLocal =
    useMemo(() => {
      if (
        !vinculoSelecionado
      ) {
        return "Local nao selecionado";
      }

      return (
        vinculoSelecionado.localNome ||
        vinculoSelecionado.condominioNome ||
        vinculoSelecionado.localSlug ||
        vinculoSelecionado.condominioSlug ||
        vinculoSelecionado.localId ||
        vinculoSelecionado.condominioId ||
        vinculoSelecionadoId ||
        "Local"
      );
    }, [
      vinculoSelecionado,
      vinculoSelecionadoId,
    ]);

  const unidadeId =
    useMemo(() => {
      if (
        !vinculoSelecionado
      ) {
        return null;
      }

      return (
        Object.entries(
          vinculoSelecionado.unidades ??
          {}
        ).find(
          ([, ativo]) =>
            ativo === true
        )?.[0] ??
        null
      );
    }, [
      vinculoSelecionado,
    ]);

  const tipoLocal =
    normalizarTexto(
      vinculoSelecionado
        ?.tipoLocal
    );

  const modoResidencia =
    tipoLocal ===
    "residencia";

  const permissoes =
    vinculoSelecionado
      ?.permissoes ??
    {};

  const podeReceberChamadas =
    permissoes
      .receberChamadas ===
    true;

  const podeAbrirPortao =
    permissoes
      .abrirPortao ===
    true;

  const podeVisualizarCameras =
    permissoes
      .visualizarCameras ===
    true;

  const podeControlarAlarme =
    permissoes
      .controlarAlarme ===
    true;

  const perfilPrincipalNormalizado = (
    vinculoSelecionado?.perfilPrincipal ||
    ""
  )
    .trim()
    .toLowerCase()
    .replaceAll("-", "_");

  const podeVoltarSindico =
    perfilPrincipalNormalizado === "sindico" ||
    Object.entries(
      vinculoSelecionado?.perfis ?? {}
    ).some(
      ([perfil, ativo]) =>
        ativo === true &&
        perfil
          .trim()
          .toLowerCase()
          .replaceAll("-", "_") === "sindico"
    );

  const perfisAdministrativosResidencia =
    Object.entries(
      vinculoSelecionado?.perfis ?? {}
    )
      .filter(([, ativo]) => ativo === true)
      .map(([perfil]) =>
        perfil
          .trim()
          .toLowerCase()
          .replaceAll("-", "_")
      );

  const podeGerenciarResidencia =
    perfilPrincipalNormalizado === "administrador_master" ||
    perfilPrincipalNormalizado === "proprietario" ||
    perfilPrincipalNormalizado === "responsavel" ||
    perfilPrincipalNormalizado === "gestor_local" ||
    perfilPrincipalNormalizado === "gerente" ||
    perfisAdministrativosResidencia.includes(
      "administrador_master"
    ) ||
    perfisAdministrativosResidencia.includes(
      "proprietario"
    ) ||
    perfisAdministrativosResidencia.includes(
      "responsavel"
    ) ||
    perfisAdministrativosResidencia.includes(
      "gestor_local"
    ) ||
    perfisAdministrativosResidencia.includes(
      "gerente"
    );

  async function sair() {
    try {
      setSaindo(true);

      await logout();

      window.location.href =
        "/";
    } finally {
      setSaindo(false);
    }
  }

  function abrirAtendimentoVisitantes() {
    if (
      !podeReceberChamadas &&
      modoResidencia
    ) {
      alert(
        "Este perfil nao possui permissao para receber chamadas."
      );

      return;
    }


if (modoResidencia) {
      const slugResidencia =
        vinculoSelecionado?.localSlug ||
        vinculoSelecionado?.condominioSlug ||
        vinculoSelecionadoId ||
        "";

      if (!slugResidencia) {
        alert(
          "Nao foi possivel identificar esta residencia."
        );

        return;
      }

      const unidadeResidencia =
        slugResidencia === "muller"
          ? "muller-principal"
          : `${slugResidencia}-principal`;

      router.push(
        `/morador-v2/${encodeURIComponent(
          unidadeResidencia
        )}`
      );

      return;
    }

    if (!unidadeId) {
      alert(
        "Nenhuma unidade esta vinculada a este perfil."
      );

      return;
    }

    router.push(
      `/morador-v2/${encodeURIComponent(
        unidadeId
      )}`
    );
  }

  async function abrirPortao() {
    if (
      !podeAbrirPortao ||
      abrindoPortao
    ) {
      return;
    }

    try {
      setAbrindoPortao(
        true
      );

      setStatusPortao(
        "\u23F3 Abrindo port\u00e3o..."
      );

      const resposta =
        await fetch(
          "/api/abrir-portao"
        );

      const dados =
        await resposta.json();

      if (
        !resposta.ok ||
        !dados.success
      ) {
        throw new Error(
          dados.erro ||
          dados.mensagem ||
          "Falha ao abrir o portao."
        );
      }

      setStatusPortao(
        "\u2705 Port\u00e3o aberto com sucesso"
      );
    } catch (erro) {
      console.error(
        "Erro ao abrir portao:",
        erro
      );

      setStatusPortao(
        "\u274c N\u00e3o foi poss\u00edvel abrir o port\u00e3o"
      );
    } finally {
      setAbrindoPortao(
        false
      );
    }
  }

  if (
    carregando &&
    !usuario
  ) {
    return (
      <main className="min-h-screen bg-slate-950 p-6 text-white">
        Carregando painel...
      </main>
    );
  }

  if (!usuario) {
    return (
      <main className="min-h-screen bg-slate-950 p-6 text-white">
        <section className="mx-auto max-w-xl rounded-3xl border border-slate-800 bg-slate-900 p-6">
          <h1 className="text-2xl font-black">
            Acesso nao identificado
          </h1>

          <button
            type="button"
            onClick={() =>
              router.push("/")
            }
            className="mt-5 w-full rounded-2xl bg-cyan-500 px-4 py-3 font-black text-slate-950"
          >
            Voltar ao login
          </button>
        </section>
      </main>
    );
  }

  /*
   * =====================================================
   * RESIDENCIA
   * =====================================================
   */

if (
  modoResidencia &&
  podeGerenciarResidencia
) {
  return (
    <CentralResidencia />
  );
}

  if (modoResidencia) {
    return (
      <DashboardBase>
        <section className="rounded-3xl bg-gradient-to-r from-blue-700 to-cyan-600 p-5 text-white md:p-7">
          <div className="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
            <div>
              <p className="text-sm font-black text-blue-100">
                QR Residencia
              </p>

              <h1 className="mt-1 text-3xl font-black md:text-4xl">
                Ol&aacute;,{" "}
                {usuario.nome
                  ?.split(" ")[0] ||
                  "Morador"}
              </h1>

              <p className="mt-2 text-sm text-blue-100 md:text-base">
                Seus acessos na resid&ecirc;ncia, conforme as permiss&otilde;es autorizadas.
              </p>
            </div>

            <button
              type="button"
              onClick={sair}
              disabled={
                saindo
              }
              className="rounded-2xl border border-white/40 bg-white/15 px-5 py-3 text-sm font-black text-white transition hover:bg-white/25 disabled:opacity-60"
            >
              {saindo
                ? "Saindo..."
                : "Sair"}
            </button>
          </div>

          <div className="mt-5 rounded-2xl border border-white/20 bg-black/10 p-4">
            <p className="text-xs font-bold uppercase tracking-wider text-blue-100">
              Resid&ecirc;ncia atual
            </p>

            <p className="mt-1 text-lg font-black">
              {nomeLocal}
            </p>
          </div>
        </section>

        <section className="mt-5 rounded-3xl border border-slate-800 bg-slate-900 p-5 md:p-6">
          <p className="text-xs font-black uppercase tracking-wider text-cyan-400">
            Meus acessos
          </p>

          <h2 className="mt-1 text-2xl font-black text-white">
            Acesso r&aacute;pido
          </h2>

          <p className="mt-2 text-sm text-slate-400">
            Aqui aparecem somente os recursos autorizados pelo respons&aacute;vel da resid&ecirc;ncia.
          </p>

          <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">

            {podeReceberChamadas && (
              <button
                type="button"
                onClick={
                  abrirAtendimentoVisitantes
                }
                className="rounded-2xl border border-blue-800 bg-blue-950/40 p-5 text-left transition hover:border-blue-500 hover:bg-blue-950 active:scale-[0.98]"
              >
                <div className="text-3xl">
                  &#128276;
                </div>

                <div className="mt-3 font-black text-white">
                  Atendimento de visitantes
                </div>

                <div className="mt-1 text-sm text-slate-400">
                  Receba chamadas de quem estiver na entrada.
                </div>
              </button>
            )}

            {podeAbrirPortao && (
              <button
                type="button"
                onClick={
                  abrirPortao
                }
                disabled={
                  abrindoPortao
                }
                className="rounded-2xl border border-violet-800 bg-violet-950/40 p-5 text-left transition hover:border-violet-500 hover:bg-violet-950 active:scale-[0.98] disabled:opacity-60"
              >
                <div className="text-3xl">
                  &#128682;
                </div>

                <div className="mt-3 font-black text-white">
                  Abrir port&atilde;o
                </div>

                <div className="mt-1 text-sm text-slate-400">
                  Acione o port&atilde;o autorizado desta resid&ecirc;ncia.
                </div>
              </button>
            )}

            {podeVisualizarCameras && (
              <div className="rounded-2xl border border-cyan-800 bg-cyan-950/30 p-5">
                <div className="text-3xl">
                  &#128247;
                </div>

                <div className="mt-3 font-black text-white">
                  C&acirc;meras
                </div>

                <div className="mt-1 text-sm text-slate-400">
                  Acesso autorizado &agrave;s c&acirc;meras da resid&ecirc;ncia.
                </div>
              </div>
            )}

            {podeControlarAlarme && (
              <div className="rounded-2xl border border-emerald-800 bg-emerald-950/30 p-5">
                <div className="text-3xl">
                  &#128680;
                </div>

                <div className="mt-3 font-black text-white">
                  Alarme
                </div>

                <div className="mt-1 text-sm text-slate-400">
                  Controle de alarme autorizado para este perfil.
                </div>
              </div>
            )}
          </div>

          {!podeReceberChamadas &&
            !podeAbrirPortao &&
            !podeVisualizarCameras &&
            !podeControlarAlarme && (
              <div className="mt-5 rounded-2xl border border-dashed border-slate-700 p-8 text-center">
                <p className="font-black text-white">
                  Nenhum acesso liberado
                </p>

                <p className="mt-2 text-sm text-slate-500">
                  O respons&aacute;vel da resid&ecirc;ncia ainda n&atilde;o liberou recursos para este perfil.
                </p>
              </div>
            )}

          {statusPortao && (
            <p className="mt-4 rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm font-black text-white">
              {statusPortao}
            </p>
          )}
        </section>
      </DashboardBase>
    );
  }

  /*
   * =====================================================
   * CONDOMINIO
   * Mantemos o painel existente.
   * =====================================================
   */

  return (
    <DashboardBase>
      <section className="rounded-3xl bg-gradient-to-r from-blue-700 to-cyan-600 p-5 text-white md:p-7">
        <div className="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div>
            <p className="text-sm font-bold text-blue-100">
              QR Core &bull; Morador
            </p>

            <h1 className="mt-1 text-3xl font-black md:text-4xl">
              Ol&aacute;,{" "}
              {usuario.nome
                ?.split(" ")[0] ||
                "Morador"}
            </h1>

            <p className="mt-2 text-sm text-blue-100 md:text-base">
              Tudo o que voc&ecirc; precisa do seu condom&iacute;nio e da sua unidade em um s&oacute; lugar.
            </p>
          </div>

          <div className="flex flex-wrap gap-2">
            {podeVoltarSindico && (
              <button
                type="button"
                onClick={() =>
                  router.push(
                    "/dashboard/condominio"
                  )
                }
                className="rounded-2xl border border-white/40 bg-white/15 px-5 py-3 text-sm font-black text-white transition hover:bg-white/25"
              >
                Voltar ao Painel do Síndico
              </button>
            )}

          <button
            type="button"
            onClick={
              sair
            }
            disabled={
              saindo
            }
            className="rounded-2xl border border-white/40 bg-white/15 px-5 py-3 text-sm font-black text-white transition hover:bg-white/25 disabled:opacity-60"
          >
            {saindo
              ? "Saindo..."
              : "Sair"}
          </button>
          </div>
        </div>

        <div className="mt-5 rounded-2xl border border-white/20 bg-black/10 p-4">
          <p className="text-xs font-bold uppercase tracking-wider text-blue-100">
            Contexto atual
          </p>

          <p className="mt-1 text-lg font-black">
            {nomeLocal}
          </p>

          <p className="mt-1 text-sm text-blue-100">
            {tipoLocal ||
              "condominio"}

            {unidadeId
              ? ` - Unidade ${unidadeId}`
              : ""}
          </p>
        </div>
      </section>

      <section className="mt-5 rounded-3xl border border-slate-800 bg-slate-900 p-5 md:p-6">
        <p className="text-xs font-black uppercase tracking-wider text-cyan-400">
          Minha unidade
        </p>

        <h2 className="mt-1 text-2xl font-black text-white">
          Acesso r&aacute;pido
        </h2>

        <p className="mt-2 text-sm text-slate-400">
          Os recursos dispon&iacute;veis aqui ser&atilde;o definidos pelo condom&iacute;nio, plano contratado e permiss&otilde;es do seu perfil.
        </p>

        <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <button
            type="button"
            onClick={
              abrirAtendimentoVisitantes
            }
            className="rounded-2xl border border-slate-700 bg-slate-800 p-5 text-left transition hover:border-cyan-500 hover:bg-slate-700 active:scale-[0.98]"
          >
            <div className="text-3xl">
              &#128276;
            </div>

            <div className="mt-3 font-black text-white">
              Atendimento de visitantes
            </div>

            <div className="mt-1 text-sm text-slate-400">
              Abra o painel de chamadas da sua unidade.
            </div>
          </button>

          <div className="rounded-2xl border border-slate-800 bg-slate-950/70 p-5">
            <div className="text-3xl">
              &#128230;
            </div>

            <div className="mt-3 font-black text-white">
              Entregas
            </div>

            <div className="mt-1 text-sm text-slate-500">
              Ser&aacute; exibido quando o m&oacute;dulo estiver ativo para este condom&iacute;nio.
            </div>
          </div>

          <div className="rounded-2xl border border-slate-800 bg-slate-950/70 p-5">
            <div className="text-3xl">
              &#128226;
            </div>

            <div className="mt-3 font-black text-white">
              Comunicados
            </div>

            <div className="mt-1 text-sm text-slate-500">
              Ser&aacute; exibido conforme as permiss&otilde;es e m&oacute;dulos ativos.
            </div>
          </div>
        </div>
      </section>
    </DashboardBase>
  );
}
